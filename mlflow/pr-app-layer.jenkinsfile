@Library('d11-jenkins-lib@master') _
def REGISTRY="954754807219.dkr.ecr.us-east-1.amazonaws.com"
def result
def build

def SERVICE_NAME="darwin-mlflow-app"
def STAGE_RETRY_COUNT=0
def STAGE_BACKOFF_SECONDS=600

def kubeSubst(placeholder, value, file) {
  sh "sed -i s/\\\${$placeholder}/$value/g $file"
}

pipeline {
  agent { label 'kube' }
  options{
    ansiColor('xterm')
  }
  stages {
    stage('intial step') {
      steps{
        script {
           intialSetup()
        }
      }
    }
    stage('Seed') {
      when { expression { params.restore_seed.toString() == 'true' && params.env_name != "" } }
      steps{
        doSeed("${SERVICE_NAME}", "${GIT_BRANCH}")
      }
    }
    stage('Push: Push to Jfrog') {
        steps {
            retryWithBackoff(STAGE_RETRY_COUNT, STAGE_BACKOFF_SECONDS) {
                script {
                    releasePackage(["${SERVICE_NAME}"], "main")
                }
            }
        }
    }
    stage('post step') {
      steps{
        script {
            postStep()
        }
      }
    }
  }
}